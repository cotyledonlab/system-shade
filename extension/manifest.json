{
  "manifest_version": 3,
  "name": "System Shade",
  "version": "1.0.0",
  "description": "Follow system appearance, darkening light websites while preserving existing dark themes.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png", "1024": "icons/icon-1024.png" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "System Shade" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["vendor/darkreader.js", "appearance.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
